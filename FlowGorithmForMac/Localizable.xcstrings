    "“%@” can't be converted to %@.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” non può essere convertito in %2$@."
          }
        }
      }
    },
    "“%@” can't work on %@ and %@. To join text use &.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” non funziona con %2$@ e %3$@. Per unire testi usa &."
          }
        }
      }
    },
    "“%@” can't work on a %@ value.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” non funziona con un valore %2$@."
          }
        }
      }
    },
    "“%@” doesn't return a value, so it can't be used in an expression. Use a Call shape.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non restituisce un valore, quindi non può stare in un'espressione. Usa un blocco Chiamata."
          }
        }
      }
    },
    "“%@” ends too early: something is missing.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” finisce troppo presto: manca qualcosa."
          }
        }
      }
    },
    "“%@” in “%@” expects %@, but got %@.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” in “%2$@” si aspetta %3$@, ma ha ricevuto %4$@."
          }
        }
      }
    },
    "“%@” is a reserved word and can't be used as a name.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” è una parola riservata e non può essere usata come nome."
          }
        }
      }
    },
    "“%@” is a reserved word.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” è una parola riservata."
          }
        }
      }
    },
    "“%@” is an array: use an index, as in %@[0].": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” è un array: usa un indice, come in %2$@[0]."
          }
        }
      }
    },
    "“%@” is outside the flowchart's folder. Allow only if you trust whoever made this flowchart.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” è fuori dalla cartella del diagramma. Consenti solo se ti fidi di chi ha creato questo diagramma."
          }
        }
      }
    },
    "“%@” isn't a text file: it's a folder or a special file.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un file di testo: è una cartella o un file speciale."
          }
        }
      }
    },
    "“%@” isn't a valid %@. Try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” non è un valore %2$@ valido. Riprova."
          }
        }
      }
    },
    "“%@” isn't a valid name: use a letter followed by letters or digits, no spaces or symbols.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un nome valido: usa una lettera seguita da lettere o cifre, senza spazi né simboli."
          }
        }
      }
    },
    "“%@” isn't a valid number.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un numero valido."
          }
        }
      }
    },
    "“%@” isn't a variable name.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è il nome di una variabile."
          }
        }
      }
    },
    "“%@” isn't an array, so it can't be used with [ ].": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un array, quindi non si può usare con [ ]."
          }
        }
      }
    },
    "“%@” needs %lld arguments, but got %lld.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” richiede %2$lld argomenti, ma ne ha ricevuti %3$lld."
          }
        }
      }
    },
    "“%@”: this flowchart isn't saved yet, so every file needs your permission. Allow only if you trust whoever made it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”: questo diagramma non è ancora salvato, quindi ogni file richiede il tuo permesso. Consenti solo se ti fidi di chi l'ha creato."
          }
        }
      }
    },
    "…and %lld more": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "…e altri %lld"
          }
        }
      }
    }
